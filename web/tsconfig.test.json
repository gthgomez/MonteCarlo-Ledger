{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist-test",
    "noEmit": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "types": ["node"]
  },
  "include": [
    "src/contract/__tests__/**/*.ts",
    "src/contract/*.ts",
    "src/lib/__tests__/**/*.ts",
    "src/lib/scenario-builder.ts",
    "src/lib/types.ts"
  ],
  "exclude": ["node_modules", "dist-test"]
}
