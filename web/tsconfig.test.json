{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": "dist-test",
    "noEmit": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/contract/__tests__/**/*.ts",
    "src/contract/*.ts",
    "src/lib/__tests__/**/*.ts",
    "src/lib/scenario-builder.ts",
    "src/lib/types.ts",
    "src/lib/validate.ts",
    "src/lib/turso.ts",
    "src/lib/crypto.ts",
    "src/lib/sync-state.ts",
    "src/lib/vault-client.ts"
  ],
  "exclude": [
    "node_modules",
    "dist-test"
  ]
}
